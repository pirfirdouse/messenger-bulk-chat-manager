
(async function () {

    // =====================================================
    // SOLVEDWEB BULK CHAT PROCESSOR - VERSION 6
    // AUTOMATIC DELETE CONFIRMATION
    // =====================================================

    const SETTINGS = {
        BEFORE_ACTION: 1500,
        AFTER_MENU_CLICK: 700,
        BEFORE_CONFIRMATION: 1500,
        AFTER_CONFIRMATION: 2000,
        BETWEEN_CHATS: 1500,
        WAIT_TIMEOUT: 15000,
        SCAN_INTERVAL: 250
    };

    // =====================================================
    // LOGGER
    // =====================================================

    document.getElementById('archive-log-box')?.remove();

    function createLogBox() {

        if (document.getElementById('archive-log-box')) return;

        const box = document.createElement('div');
        box.id = 'archive-log-box';

        Object.assign(box.style, {
            position: 'fixed',
            top: '20px',
            right: '20px',
            width: '350px',
            height: '85vh',
            maxHeight: '800px',
            background: 'rgba(20,20,20,.97)',
            color: 'white',
            borderRadius: '8px',
            boxShadow: '0 4px 12px rgba(0,0,0,.5)',
            zIndex: '999999',
            overflow: 'hidden',
            fontFamily: 'monospace',
            fontSize: '12px',
            border: '1px solid #555'
        });

        const header = document.createElement('div');
        header.textContent = 'Bulk Action Log';

        Object.assign(header.style, {
            padding: '10px',
            background: '#333',
            fontWeight: 'bold'
        });

        const content = document.createElement('div');
        content.id = 'archive-log-content';

        Object.assign(content.style, {
            padding: '10px',
            height: 'calc(100% - 37px)',
            overflowY: 'auto'
        });

        box.append(header, content);
        document.body.appendChild(box);
    }

    function logOutput(message, type = 'info') {

        createLogBox();

        const content = document.getElementById(
            'archive-log-content'
        );

        const entry = document.createElement('div');

        const timestamp = document.createElement('span');
        timestamp.style.color = '#888';
        timestamp.textContent =
            new Date().toLocaleTimeString() + ': ';

        entry.append(
            timestamp,
            document.createTextNode(message)
        );

        if (type === 'success') entry.style.color = '#a0ff9a';
        if (type === 'error') entry.style.color = '#ff8a8a';
        if (type === 'warning') entry.style.color = '#ffd700';

        content.appendChild(entry);
        content.scrollTop = content.scrollHeight;
    }

    // =====================================================
    // HELPERS
    // =====================================================

    function sleep(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    function normalizeText(element) {
        return (
            element.innerText ||
            element.textContent ||
            ''
        ).replace(/\s+/g, ' ').trim().toLowerCase();
    }

    function isVisible(element) {

        if (!element || !element.isConnected) return false;

        const rect = element.getBoundingClientRect();
        const style = getComputedStyle(element);

        return (
            rect.width > 0 &&
            rect.height > 0 &&
            style.display !== 'none' &&
            style.visibility !== 'hidden'
        );
    }

    async function waitFor(check) {

        const start = Date.now();

        while (Date.now() - start < SETTINGS.WAIT_TIMEOUT) {

            const result = check();

            if (result) return result;

            await sleep(SETTINGS.SCAN_INTERVAL);
        }

        return null;
    }

    // =====================================================
    // CHAT DISCOVERY
    // =====================================================

    function getChatButtons() {

        return [
            ...document.querySelectorAll(
                'button[aria-label^="More options for"], ' +
                '[role="button"][aria-label^="More options for"]'
            )
        ];
    }

    function getChatName(button) {

        return (
            button.getAttribute('aria-label') || ''
        ).replace(/^More options for\s*/i, '').trim();
    }

    function scanChats() {

        const chats = [];
        const seen = new Set();

        getChatButtons().forEach(button => {

            if (!isVisible(button)) return;

            const name = getChatName(button);

            if (!name || seen.has(name)) return;

            seen.add(name);

            chats.push({
                displayName: name
            });
        });

        return chats;
    }

    function findChatButton(name) {

        return getChatButtons().find(button =>
            isVisible(button) &&
            getChatName(button) === name
        ) || null;
    }

    // =====================================================
    // SELECTION MODAL
    // =====================================================

    function showChatSelectorModal(chats) {

        return new Promise((resolve, reject) => {

            const style = document.createElement('style');
            style.id = 'bulk-modal-styles';

            style.textContent = `
                #bulk-action-overlay {
                    position:fixed;
                    inset:0;
                    background:rgba(0,0,0,.75);
                    backdrop-filter:blur(5px);
                    z-index:1000000;
                    display:flex;
                    justify-content:center;
                    align-items:center;
                    font-family:Arial,sans-serif;
                }

                #bulk-action-modal {
                    width:550px;
                    max-width:95vw;
                    max-height:85vh;
                    display:flex;
                    flex-direction:column;
                    background:#282a2d;
                    color:white;
                    border-radius:12px;
                    overflow:hidden;
                }

                #modal-header {
                    padding:18px;
                    text-align:center;
                    border-bottom:1px solid #555;
                }

                #modal-body {
                    padding:18px;
                    overflow-y:auto;
                }

                .chat-list-item {
                    padding:9px;
                    display:flex;
                    align-items:center;
                    border-radius:6px;
                }

                .chat-list-item:hover {
                    background:#414448;
                }

                .chat-list-item input {
                    margin-right:14px;
                }

                .chat-list-item label {
                    cursor:pointer;
                    flex:1;
                }

                #modal-footer {
                    padding:16px;
                    border-top:1px solid #555;
                    display:flex;
                    justify-content:space-between;
                    flex-wrap:wrap;
                    gap:10px;
                }

                .modal-btn {
                    border:0;
                    padding:10px 14px;
                    margin:2px;
                    border-radius:6px;
                    color:white;
                    font-weight:bold;
                    cursor:pointer;
                }

                .secondary-btn {background:#626970}
                .action-btn {background:#087bdb}
                .danger-btn {background:#c83240}
            `;

            document.head.appendChild(style);

            const overlay = document.createElement('div');
            overlay.id = 'bulk-action-overlay';

            const modal = document.createElement('div');
            modal.id = 'bulk-action-modal';

            const header = document.createElement('div');
            header.id = 'modal-header';
            header.textContent = 'Bulk Chat Processor';

            const body = document.createElement('div');
            body.id = 'modal-body';

            const selectAll = document.createElement('button');
            selectAll.className = 'modal-btn secondary-btn';
            selectAll.textContent = 'Select All';

            const deselectAll = document.createElement('button');
            deselectAll.className = 'modal-btn secondary-btn';
            deselectAll.textContent = 'Deselect All';

            body.append(selectAll, deselectAll);

            const checkboxes = [];

            chats.forEach((chat, index) => {

                const row = document.createElement('div');
                row.className = 'chat-list-item';

                const checkbox = document.createElement('input');
                checkbox.type = 'checkbox';
                checkbox.id = 'bulk-chat-' + index;
                checkbox.value = index;

                const label = document.createElement('label');
                label.htmlFor = checkbox.id;
                label.textContent = chat.displayName;

                row.append(checkbox, label);
                body.appendChild(row);

                checkboxes.push(checkbox);
            });

            const footer = document.createElement('div');
            footer.id = 'modal-footer';

            const counter = document.createElement('span');
            counter.textContent = '0 items selected';

            const buttons = document.createElement('div');

            function makeButton(text, className) {

                const button = document.createElement('button');
                button.className = 'modal-btn ' + className;
                button.textContent = text;

                return button;
            }

            const cancel = makeButton('Cancel', 'secondary-btn');
            const archive = makeButton('Archive Selected', 'action-btn');
            const del = makeButton('Delete Selected', 'danger-btn');

            buttons.append(cancel, archive, del);
            footer.append(counter, buttons);

            modal.append(header, body, footer);
            overlay.appendChild(modal);
            document.body.appendChild(overlay);

            function updateCounter() {

                counter.textContent =
                    checkboxes.filter(cb => cb.checked).length +
                    ' item(s) selected';
            }

            checkboxes.forEach(cb =>
                cb.addEventListener('change', updateCounter)
            );

            selectAll.onclick = () => {
                checkboxes.forEach(cb => cb.checked = true);
                updateCounter();
            };

            deselectAll.onclick = () => {
                checkboxes.forEach(cb => cb.checked = false);
                updateCounter();
            };

            function cleanup() {
                overlay.remove();
                style.remove();
            }

            function handleAction(action) {

                const selected = checkboxes
                    .filter(cb => cb.checked)
                    .map(cb => chats[Number(cb.value)]);

                if (!selected.length) {
                    alert('Please select at least one chat.');
                    return;
                }

                if (action === 'delete') {

                    if (!confirm(
                        `Permanently delete ${selected.length} selected chats? This cannot be undone.`
                    )) return;
                }

                cleanup();

                resolve({
                    action,
                    selectedChats: selected
                });
            }

            archive.onclick = () => handleAction('archive');
            del.onclick = () => handleAction('delete');

            cancel.onclick = () => {
                cleanup();
                reject('Cancelled');
            };
        });
    }

    // =====================================================
    // FIND INITIAL MENU ACTION
    // =====================================================

    async function findMenuAction(action) {

        const expected = action === 'archive'
            ? 'archive chat'
            : 'delete chat';

        return await waitFor(() => {

            const items = document.querySelectorAll(
                '[role="menuitem"]'
            );

            return [...items].find(item =>
                isVisible(item) &&
                normalizeText(item) === expected
            ) || null;
        });
    }

    // =====================================================
    // AUTOMATIC FINAL DELETE CONFIRMATION
    // =====================================================

    async function confirmFinalDelete() {

        logOutput(
            'Waiting for the final deletion dialog...',
            'warning'
        );

        await sleep(SETTINGS.BEFORE_CONFIRMATION);

        const dialog = await waitFor(() => {

            return [...document.querySelectorAll(
                '[role="dialog"]'
            )].find(element => {

                if (!isVisible(element)) return false;

                const text = normalizeText(element);

                return (
                    text.includes('once you delete your copy') &&
                    text.includes('cannot be undone')
                );

            }) || null;
        });

        if (!dialog) {

            logOutput(
                'Delete confirmation dialog not found.',
                'error'
            );

            return false;
        }

        logOutput(
            'Correct Delete chat confirmation dialog identified.',
            'success'
        );

        const deleteButton = await waitFor(() => {

            const buttons = dialog.querySelectorAll(
                'button, [role="button"]'
            );

            return [...buttons].find(button => {

                if (!isVisible(button)) return false;

                const text = normalizeText(button);

                const aria = (
                    button.getAttribute('aria-label') || ''
                ).trim().toLowerCase();

                return (
                    text === 'delete chat' ||
                    aria === 'delete chat'
                );

            }) || null;
        });

        if (!deleteButton) {

            logOutput(
                'Final Delete Chat button not found.',
                'error'
            );

            return false;
        }

        logOutput(
            'Final Delete Chat button located. Clicking automatically...',
            'success'
        );

        await sleep(500);

        // Recheck the dialog and button before clicking.
        if (
            !dialog.isConnected ||
            !deleteButton.isConnected ||
            !isVisible(deleteButton)
        ) {

            logOutput(
                'Confirmation dialog changed. Deletion stopped.',
                'error'
            );

            return false;
        }

        // No manual confirmation prompt.
        deleteButton.click();

        logOutput(
            'Final Delete Chat confirmation clicked automatically.',
            'success'
        );

        await sleep(SETTINGS.AFTER_CONFIRMATION);

        return true;
    }

    // =====================================================
    // WAIT FOR CHAT TO DISAPPEAR
    // =====================================================

    async function waitForChatRemoval(name) {

        logOutput(
            'Waiting for chat to disappear from sidebar...',
            'warning'
        );

        const removed = await waitFor(() =>
            !findChatButton(name)
        );

        return !!removed;
    }

    // =====================================================
    // MAIN PROCESS
    // =====================================================

    async function startBulkAction() {

        logOutput(
            'Starting Bulk Action Script v6...',
            'success'
        );

        const chats = scanChats();

        logOutput(
            `Found ${chats.length} visible chat menu buttons.`,
            chats.length ? 'success' : 'error'
        );

        if (!chats.length) {

            logOutput('No chats found.', 'error');
            return;
        }

        let result;

        try {
            result = await showChatSelectorModal(chats);
        } catch {
            logOutput('Selection cancelled.', 'warning');
            return;
        }

        const { action, selectedChats } = result;

        logOutput(
            `${action.toUpperCase()}: ${selectedChats.length} selected.`,
            'warning'
        );

        let completed = 0;
        let failed = 0;

        for (let i = 0; i < selectedChats.length; i++) {

            const chat = selectedChats[i];

            logOutput(
                `[${i + 1}/${selectedChats.length}] ${chat.displayName}`
            );

            await sleep(SETTINGS.BEFORE_ACTION);

            const menuButton = await waitFor(
                () => findChatButton(chat.displayName)
            );

            if (!menuButton) {

                logOutput(
                    'Chat not found in current sidebar. Skipping.',
                    'error'
                );

                failed++;
                continue;
            }

            menuButton.click();

            await sleep(SETTINGS.AFTER_MENU_CLICK);

            const actionButton = await findMenuAction(action);

            if (!actionButton) {

                logOutput(
                    'Requested menu action not found.',
                    'error'
                );

                failed++;
                continue;
            }

            actionButton.click();

            logOutput(
                'Initial menu action clicked.',
                'success'
            );

            // ---------------- DELETE ----------------

            if (action === 'delete') {

                const confirmed = await confirmFinalDelete();

                if (!confirmed) {

                    failed++;

                    logOutput(
                        'Deletion was not confirmed. Stopping bulk operation.',
                        'error'
                    );

                    break;
                }

                const removed = await waitForChatRemoval(
                    chat.displayName
                );

                if (!removed) {

                    failed++;

                    logOutput(
                        'Deletion could not be verified. Stopping.',
                        'error'
                    );

                    break;
                }

                completed++;

                logOutput(
                    'Chat disappeared from sidebar after confirmation.',
                    'success'
                );
            }

            // ---------------- ARCHIVE ----------------

            else {

                const archived = await waitFor(() =>
                    !findChatButton(chat.displayName)
                );

                if (!archived) {

                    failed++;

                    logOutput(
                        'Archive could not be verified. Stopping.',
                        'error'
                    );

                    break;
                }

                completed++;

                logOutput(
                    'Chat disappeared from sidebar after archive.',
                    'success'
                );
            }

            if (i < selectedChats.length - 1) {

                logOutput(
                    `Waiting ${SETTINGS.BETWEEN_CHATS / 1000} seconds before next chat.`,
                    'warning'
                );

                await sleep(SETTINGS.BETWEEN_CHATS);
            }
        }

        logOutput(
            `PROCESS FINISHED. Completed: ${completed}. Failed or unverified: ${failed}.`,
            failed ? 'warning' : 'success'
        );
    }

    // =====================================================
    // RUN
    // =====================================================

    createLogBox();
    await startBulkAction();

})();
